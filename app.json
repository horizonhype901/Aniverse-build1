{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0A1A",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.retromuzik.aniverse",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.retromuzik.aniverse",
      "supportsTablet": true
    },
    "name": "AniVerse",
    "orientation": "portrait",
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0A1A",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "aniverse",
    "slug": "aniverse",
    "userInterfaceStyle": "dark",
    "version": "1.5.0",
    "extra": {
      "eas": {
        "projectId": "173ecc87-4aa0-4c77-89be-b2f608a62fb1"
      }
    },
    "owner": "stevenjoinersr"
  }
}
